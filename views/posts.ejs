<div class="max-w-[1100px] mx-auto p-5 relative">
    <h1 class="text-2xl font-bold text-neutral-900 mb-4">Лента постов</h1>

    <%# 1. ПАНЕЛЬ УПРАВЛЕНИЯ: Показываем форму только авторизованным %>
        <% if (currentUser) { %>
            <div class="flex justify-end mb-4">
                <button
                    class="inline-flex items-center gap-2 bg-fish-purplePale text-[#2b0a4a] rounded-full pl-2 pr-[18px] py-2 text-sm font-semibold hover:bg-fish-purpleLight hover:-translate-y-px transition"
                    onclick="togglePostForm()">
                    <span
                        class="inline-flex items-center justify-center w-7 h-7 bg-fish-purple text-white rounded-full text-lg leading-none">+</span>
                    <span>Создать пост</span>
                </button>
            </div>

            <div class="mb-5" id="post-form-wrapper" hidden>
                <form id="add-post-form" class="bg-white p-5 rounded-xl shadow-sm">
                    <h2 class="text-lg font-semibold mb-3">Поделиться уловом</h2>
                    <input type="text" id="post-title" placeholder="Заголовок (например: Щука на 5 кг!)" required
                        class="w-full box-border px-3 py-2.5 mb-2.5 border border-neutral-300 rounded-lg text-sm" />
                    <textarea id="post-content" placeholder="Расскажи, как прошла рыбалка..." rows="4" required
                        class="w-full box-border px-3 py-2.5 mb-2.5 border border-neutral-300 rounded-lg text-sm resize-y"></textarea>

                    <label for="post-image"
                        class="flex items-center gap-2 px-3.5 py-2.5 mb-2.5 border-2 border-dashed border-fish-purpleLight rounded-lg bg-[#faf5ff] text-fish-purple text-sm font-medium cursor-pointer hover:bg-[#f3e8ff] transition">
                        <span class="text-lg leading-none">📷</span>
                        <span id="file-input-text">Выбрать фото с компьютера</span>
                    </label>
                    <input type="file" id="post-image" name="image" accept="image/png,image/jpeg,image/gif,image/webp"
                        class="absolute w-px h-px opacity-0 pointer-events-none" />

                    <div class="flex gap-2 justify-end">
                        <button type="submit" class="btn-add">Опубликовать</button>
                        <button type="button" class="btn-clear" onclick="togglePostForm()">Отмена</button>
                    </div>
                </form>
            </div>
            <% } else { %>
                <div class="text-center p-6 bg-yellow-50 border border-yellow-200 rounded-xl mb-6">
                    <p class="text-neutral-800 mb-2">Вы просматриваете ленту как гость.</p>
                    <p class="text-sm text-neutral-600">
                        Чтобы создавать посты и удалять свои записи,
                        <a href="/login"
                            class="text-fish-purple font-bold underline hover:text-fish-purpleLight">войдите в
                            аккаунт</a>.
                    </p>
                </div>
                <% } %>

                    <%# 2. СЕТКА ПОСТОВ %>
                        <section class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[600px]:grid-cols-1"
                            id="posts-grid">
                            <% posts.forEach((post)=> { %>
                                <article
                                    class="group relative bg-white rounded-xl shadow-sm flex flex-col hover:-translate-y-0.5 hover:shadow-lg transition"
                                    data-post-id="<%= post.id %>">

                                    <%# 3. КНОПКА УДАЛЕНИЯ: Показываем ТОЛЬКО если авторизованный юзер совпадает с
                                        автором %>
                                        <% if (currentUser && post.authorId===currentUser.uid) { %>
                                            <button
                                                class="absolute top-2 right-2 z-10 w-7 h-7 rounded-full border-none bg-black/55 text-white text-base leading-none cursor-pointer flex items-center justify-center opacity-0 transition hover:bg-red-600 group-hover:opacity-100"
                                                onclick="deletePost('<%= post.id %>', this)" title="Удалить пост"
                                                aria-label="Удалить пост">×</button>
                                            <% } %>

                                                <div
                                                    class="w-full aspect-[3/4] bg-[#f3e7a1] flex items-center justify-center overflow-hidden rounded-t-xl">
                                                    <% if (post.image_url) { %>
                                                        <img src="<%= post.image_url %>" alt="<%= post.title %>"
                                                            class="w-full h-full object-cover block" />
                                                        <% } else { %>
                                                            <span
                                                                class="text-[#b3a35a] text-sm font-semibold tracking-wider uppercase">Фото</span>
                                                            <% } %>
                                                </div>

                                                <div class="px-3.5 pt-3 pb-3.5 flex flex-col flex-1">
                                                    <h3 class="text-base font-bold text-neutral-900 mb-1.5">
                                                        <%= post.title %>
                                                    </h3>
                                                    <p
                                                        class="post-content text-sm text-neutral-700 leading-snug mb-2.5">
                                                        <%= post.content %>
                                                    </p>
                                                    <div class="flex justify-between text-xs text-neutral-400 mt-auto">
                                                        <span>
                                                            <%= post.authorName || "Аноним" %>
                                                        </span>
                                                        <span>
                                                            <%= post.created_at %>
                                                        </span>
                                                    </div>
                                                </div>
                                </article>
                                <% }); %>
                        </section>

                        <%# Кнопка "вниз" %>
                            <div class="flex justify-center items-center mx-auto mt-8 mb-5 w-11 h-11 bg-fish-purple rounded-full shadow-lg cursor-pointer select-none hover:bg-[#531b8c] hover:translate-y-0.5 transition"
                                onclick="scrollDown()" title="Прокрутить вниз">
                                <img src="/static/icons/DownArrow.png" alt="Вниз"
                                    class="w-[22px] h-[22px] brightness-0 invert" />
                            </div>
</div>

<script>
    function togglePostForm() {
        var wrapper = document.getElementById('post-form-wrapper');
        if (wrapper) {
            wrapper.hidden = !wrapper.hidden;
            if (!wrapper.hidden) document.getElementById('post-title').focus();
        }
    }

    function scrollDown() {
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }

    // Обработка выбора файла (безопасно проверяем, существует ли элемент)
    var fileInput = document.getElementById('post-image');
    if (fileInput) {
        fileInput.addEventListener('change', function () {
            var text = document.getElementById('file-input-text');
            if (this.files && this.files[0]) {
                text.textContent = this.files[0].name;
            } else {
                text.textContent = 'Выбрать фото с компьютера';
            }
        });
    }

    // Создание поста
    var addPostForm = document.getElementById('add-post-form');
    if (addPostForm) {
        addPostForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var title = document.getElementById('post-title').value;
            var content = document.getElementById('post-content').value;
            var fileInput = document.getElementById('post-image');

            var formData = new FormData();
            formData.append('title', title);
            formData.append('content', content);
            if (fileInput.files && fileInput.files[0]) {
                formData.append('image', fileInput.files[0]);
            }

            fetch('/add_post', { method: 'POST', body: formData })
                .then(function (r) {
                    if (r.status === 401) throw new Error("Вы не авторизованы");
                    return r.json();
                })
                .then(function (result) {
                    if (result.status !== 'success') {
                        alert('Ошибка: ' + result.error);
                        return;
                    }
                    location.reload(); // Перезагружаем, чтобы увидеть пост
                })
                .catch(function (err) {
                    console.error(err);
                    alert(err.message || 'Не удалось опубликовать пост');
                });
        });
    }

    // Удаление поста
    function deletePost(postId, btn) {
        if (!confirm('Удалить этот пост?')) return;
        btn.disabled = true;
        fetch('/api/posts/' + postId, { method: 'DELETE' })
            .then(function (r) {
                if (!r.ok) return r.json().then(data => { throw new Error(data.error || 'Ошибка') });
                return r.json();
            })
            .then(function (result) {
                if (result.status === 'success') {
                    var card = btn.closest('article');
                    if (card) card.remove();
                }
            })
            .catch(function (err) {
                console.error('Ошибка удаления:', err);
                alert(err.message || 'Не удалось удалить пост');
                btn.disabled = false;
            });
    }
</script>