<main class="w-full">
  <!-- 1. СЛАЙДЕР С ПОСТАМИ (Swiper) -->
  <section class="w-full mb-12 bg-neutral-50 py-8">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-end mb-6">
      <h2 class="text-2xl font-bold text-neutral-800">Последние новости</h2>
      <a href="/posts" class="text-fish-purple hover:underline text-sm font-medium">Все посты →</a>
    </div>

    <% if (posts && posts.length > 0) { %>
      <!-- Контейнер Swiper на всю ширину -->
      <div class="swiper mySwiper w-full">
        <div class="swiper-wrapper px-4 md:px-12"> 
          <% posts.forEach((post) => { %>
            <!-- Слайд -->
            <div class="swiper-slide !h-auto">
              <div class="bg-neutral-200 rounded-[20px] p-2 h-full flex flex-col shadow-sm">
                <!-- Картинка с закруглениями -->
                <div class="w-full h-[200px] rounded-[16px] overflow-hidden bg-neutral-300">
                  <% if (post.image_url) { %>
                    <img src="<%= post.image_url %>" class="w-full h-full object-cover" alt="<%= post.title %>">
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-neutral-500">Нет фото</div>
                  <% } %>
                </div>
                
                <!-- Текст под картинкой -->
                <div class="p-4 flex flex-col flex-1">
                  <h3 class="font-bold text-lg mb-2 line-clamp-2 text-neutral-900"><%= post.title %></h3>
                  <p class="text-sm text-neutral-600 line-clamp-2 mb-3 flex-1"><%= post.content %></p>
                  <span class="text-xs text-neutral-500 mt-auto font-medium">Автор: <%= post.authorName || post.author || "Аноним" %></span>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        
        <div class="swiper-pagination !relative !bottom-0 mt-6"></div>
      </div>
    <% } else { %>
      <div class="max-w-7xl mx-auto px-4">
        <p class="text-neutral-500 italic">Пока нет новостей. <a href="/posts" class="text-fish-purple underline">Добавьте первый пост!</a></p>
      </div>
    <% } %>
  </section>

  <!-- 2. СЕТКА ТОВАРОВ -->
  <section class="max-w-7xl mx-auto px-4 pb-12">
    <div class="flex justify-between items-end mb-4">
      <h2 class="text-2xl font-bold text-neutral-800">Товары</h2>
      <a href="/catalog" class="text-fish-purple hover:underline text-sm font-medium">Весь каталог →</a>
    </div>

    <% if (products && products.length > 0) { %>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <% products.forEach((product) => { %>
          <div class="bg-white p-4 rounded-lg shadow-sm text-center flex flex-col">
            <a href="/product/<%= product.id %>" class="block hover:opacity-80 transition-opacity flex-1">
              <% if (product.image_url) { %>
                <img src="<%= product.image_url %>" class="w-full h-[150px] object-cover rounded mb-2.5" alt="<%= product.name %>">
              <% } else { %>
                <div class="bg-[#f9f9b0] h-[150px] rounded mb-2.5 flex items-center justify-center text-neutral-400">Фото</div>
              <% } %>
              <h3 class="font-semibold text-sm line-clamp-2"><%= product.name %></h3>
              <p class="font-bold text-neutral-800 mt-1"><%= Number(product.price) || 0 %> ₽</p>
            </a>
            <button class="btn-add mt-2 text-sm py-1.5" onclick="addToCart('<%= product.id %>', this)">В корзину</button>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-neutral-500 italic">В каталоге пока нет товаров.</p>
    <% } %>
  </section>

</main>

<!-- ИНИЦИАЛИЗАЦИЯ SWIPER -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (document.querySelector('.mySwiper')) {
      new Swiper('.mySwiper', {
        slidesPerView: 1,
        spaceBetween: 16,
        loop: true, // Зацикливание
        autoplay: {
          delay: 3000, // Прокрутка каждые 3 секунды
          disableOnInteraction: false, // Не останавливать при клике
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true, // Можно кликать по точкам
        },
        breakpoints: {
          // Адаптив под экраны
          640: { slidesPerView: 2 },
          1024: { slidesPerView: 3 },
          1280: { slidesPerView: 4 },
        }
      });
    }
  });
</script>