<main class="max-w-[900px] mx-auto p-5">
    <h1 class="text-2xl font-bold mb-4">Корзина</h1>

    <% if (items.length> 0) { %>
        <div class="flex flex-col gap-3">
            <% items.forEach((item)=> { %>
                <div class="flex gap-4 items-center bg-white rounded-lg p-3 shadow-sm">
                    <div class="shrink-0">
                        <% if (item.image_url) { %>
                            <img src="<%= item.image_url %>" alt="<%= item.name %>"
                                class="w-[100px] h-[100px] object-cover rounded-md bg-[#f9f9b0]" />
                            <% } else { %>
                                <div
                                    class="w-[100px] h-[100px] bg-[#f9f9b0] rounded-md flex items-center justify-center text-neutral-400">
                                    Фото
                                </div>
                                <% } %>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-semibold mb-1">
                            <%= item.name %>
                        </h3>
                        <p class="font-bold text-neutral-700">
                            <%= item.price %> ₽ × <%= item.quantity %>
                        </p>
                    </div>
                    <div class="text-right">
                        <span class="block font-bold mb-1.5">
                            <%= item.subtotal %> ₽
                        </span>
                        <button class="btn-remove" onclick="removeFromCart('<%= item.id %>')">Удалить</button>
                    </div>
                </div>
                <% }); %>
        </div>

        <div class="mt-5 text-right">
            <h2 class="text-xl font-bold mb-2.5">Итого: <%= total %> ₽</h2>
            <button class="btn-add" onclick="checkout()">Оформить заказ</button>
            <button class="btn-clear" onclick="clearCart()">Очистить корзину</button>
        </div>
        <% } else { %>
            <div class="text-center py-10">
                <p class="text-neutral-600 mb-4">Корзина пуста</p>
                <a href="/catalog" class="btn-add inline-block no-underline">Перейти в каталог</a>
            </div>
            <% } %>
</main>

<%- typeof extraScripts !=="undefined" ? extraScripts : "" %>