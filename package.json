{
  "name": "fishlove",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "dev:server": "node --watch src/server.js",
    "dev": "concurrently \"npm:dev:css\" \"npm:dev:server\"",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "start": "node src/server.js"
  },
  "dependencies": {
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-ejs-layouts": "^2.5.1",
    "firebase-admin": "^12.4.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "tailwindcss": "^3.4.10"
  }
}